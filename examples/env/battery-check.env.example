# battery-check settings - copy to /etc/homelab-tools/battery-check.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# VictoriaMetrics base URL (required: house use, state of charge and rates are read from it).
VM_URL=http://127.0.0.1:8428
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status

# The battery: usable capacity (kWh), the charge the overnight window reaches, and the inverter's
# discharge floor (%).
BATTERY_KWH=10
BATTERY_FULL_PCT=100
BATTERY_RESERVE_PCT=20
# Cheap-rate window, local time (Octopus Go: 00:30-05:30).
CHEAP_HOURS=00:30-05:30
# Morning alert if the battery peaked below this overnight; evening alert if tomorrow needs at least
# this many kWh from the grid at the peak rate.
CHARGED_BELOW_PCT=90
SHORTFALL_KWH=1.0
