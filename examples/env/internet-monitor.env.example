# internet-monitor settings - copy to /etc/homelab-tools/internet-monitor.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status
VM_URL=http://127.0.0.1:8428

# Addresses to connect to; the line is up if any answers.
INTERNET_TARGETS=1.1.1.1:443 8.8.8.8:443 9.9.9.9:443
# Your router (host:port of its web page), to tell broadband faults from home-network ones.
INTERNET_GATEWAY=192.168.1.1:80
INTERNET_CHECK_S=30
# Minimum guaranteed download speed from your contract; 0 turns the slow-line alert off.
INTERNET_MIN_DOWN_MBPS=0
