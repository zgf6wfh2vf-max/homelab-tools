# octopus-collector settings - copy to /etc/homelab-tools/octopus-collector.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# VictoriaMetrics base URL (for Grafana graphs).
VM_URL=http://127.0.0.1:8428
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status

# API key from https://octopus.energy/dashboard/new/accounts/personal-details/api-access
# kept in its own file (chmod 600) rather than here.
OCTOPUS_API_KEY_FILE=/etc/homelab-tools/octopus-api-key
# Written by: OCTOPUS_API_KEY=... octopus-setup A-XXXXXXXX > /etc/homelab-tools/octopus.json
OCTOPUS_CONFIG=/etc/homelab-tools/octopus.json
#OCTOPUS_DAYS=7
# Import rates below this many pence count as off-peak (Octopus Go: cheap ~5p, peak ~26p).
OFFPEAK_BELOW_P=12
#GAS_KWH_PER_M3=11.22
# Optional: house power metric in W (e.g. from solis-monitor) to estimate solar/battery savings.
HOUSE_LOAD_METRIC=solis_load_w
