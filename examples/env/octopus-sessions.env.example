# octopus-sessions settings - copy to /etc/homelab-tools/octopus-sessions.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status

# Your Octopus API key (file preferred) and the output of octopus-setup.
OCTOPUS_API_KEY_FILE=/etc/homelab-tools/octopus-api-key
OCTOPUS_CONFIG=/etc/octopus/config.json

# Saving-session types to announce: TURN_DOWN (Power Down), TURN_UP (Power Up), WEEKEND_HAPPY_HOUR.
SESSION_TYPES=TURN_DOWN TURN_UP
# Flexibility campaigns to check: free_electricity, power_ups_ukpn, power_ups_nged, power_ups_npg,
# power_ups_scotland (regional Power-ups: pick your network operator's).
CAMPAIGNS=free_electricity
