# powerline-monitor settings - copy to /etc/homelab-tools/powerline-monitor.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status
VM_URL=http://127.0.0.1:8428

# Space-separated adapter addresses (reserve them in your DHCP server).
PLC_HOSTS=192.168.1.20 192.168.1.21
# App Mbps per raw rate unit: the devolo app's figure divided by ACTUAL_RX_BPS in the data file.
PLC_RATE_SCALE=0.0533
# Alert when a link falls below this percentage of its usual rate.
PLC_DROP_PCT=50
# Before calling a link slow, push traffic across so the adapters re-measure (see the docs).
PLC_REFRESH_MB=20
# A download that comes in over the powerline (leave empty if the router is on this side).
PLC_REFRESH_URL=https://speed.cloudflare.com/__down?bytes=25000000
PLC_REFRESH_MIN=15
