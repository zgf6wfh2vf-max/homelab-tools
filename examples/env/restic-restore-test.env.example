# restic-restore-test settings - copy to /etc/homelab-tools/restic-restore-test.env (chmod 640)
# restic's own settings (repository, password, credentials) come from your backup job's environment
# file - see the EnvironmentFile= lines in restic-restore-test.service.

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status

# restic arguments selecting which snapshots to test (the newest match is used).
RESTORE_SNAPSHOT_FILTER=--host myhost --tag nightly
# How much to restore: number of files, and a size budget in MB.
RESTORE_SAMPLE_FILES=20
RESTORE_MAX_MB=200
# Fail if the newest snapshot is older than this many days.
RESTORE_MAX_AGE_DAYS=2
# Scratch space for the temporary restore.
RESTORE_DIR=/var/tmp
