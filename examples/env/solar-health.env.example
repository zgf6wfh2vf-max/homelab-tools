# solar-health settings - copy to /etc/homelab-tools/solar-health.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status
# VictoriaMetrics with solis-monitor's (and optionally solar-forecast's) metrics (required).
VM_URL=http://127.0.0.1:8428

# Battery capacity in kWh, for counting charge cycles.
BATTERY_KWH=10
# Thresholds: relative change in the string ratio; week's generation as a fraction of usual vs forecast;
# battery health alert level and 30-day drop.
STRING_TOLERANCE=0.2
FORECAST_DROP=0.6
SOH_WARN_PCT=80
SOH_DROP_PTS=3
