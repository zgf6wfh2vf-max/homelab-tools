# sqlite-snapshot-backup settings - copy to /etc/default/sqlite-snapshot-backup
SNAPSHOT_SOURCE=/opt/stacks
#SNAPSHOT_EXTRA=/mnt/backup-disk/appdata
SNAPSHOT_DEST=/mnt/backup/snapshots
SNAPSHOT_KEEP=14
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Optional heartbeat, e.g. an Uptime Kuma push monitor with a 25 h interval.
#HEARTBEAT_URL=http://127.0.0.1:3001/api/push/CHANGE-ME
