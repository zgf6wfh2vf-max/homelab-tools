# tariff-compare settings - copy to /etc/homelab-tools/tariff-compare.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status
# VictoriaMetrics with octopus-collector's metrics (required).
VM_URL=http://127.0.0.1:8428

# Output of octopus-setup: gives your region and when your fixed deals end.
OCTOPUS_CONFIG=/etc/octopus/config.json
# Import below this rate (pence) is treated as battery/EV charging that would move to another tariff's cheap times.
OFFPEAK_BELOW_P=12
