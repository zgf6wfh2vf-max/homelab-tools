# usage-watch settings - copy to /etc/homelab-tools/usage-watch.env (chmod 640)

# Where results go - each line is optional (leave empty to disable that output).
# ntfy topic URL: treat the topic name like a password (anyone who knows it can read your alerts).
NTFY_URL=https://ntfy.sh/CHANGE-ME-to-a-long-random-topic
# Directory for dashboard status JSON (served read-only to e.g. Homepage).
STATUS_DIR=/var/lib/homelab-status
# VictoriaMetrics (required).
VM_URL=http://127.0.0.1:8428

# Location for daily outside temperatures (Open-Meteo); a nearby town is enough.
# Leave empty to skip the gas check.
WEATHER_LAT=
WEATHER_LON=

# Gas: alert when a day is above ALL of: GAS_SIGMA standard deviations, GAS_MIN_EXCESS_PCT % and
# GAS_MIN_EXCESS_KWH kWh over what the weather explains.
GAS_SIGMA=3
GAS_MIN_EXCESS_PCT=25
GAS_MIN_EXCESS_KWH=5
# Electricity: alert when the always-on load is BASELOAD_FACTOR x usual and BASELOAD_MIN_W higher, two days running.
BASELOAD_FACTOR=1.5
BASELOAD_MIN_W=100
