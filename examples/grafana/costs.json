 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Electricity import",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(sum_over_time(octopus_import_cost_p[$__range]))/100",
     "legendFormat": "Electricity import",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyGBP",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
