{
 "uid": "heating",
 "title": "Heating",
 "tags": [
  "tado",
  "octopus"
 ],
 "timezone": "browser",
 "editable": true,
 "refresh": "2m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Room and outside temperature",
   "description": "Dashed = target set by the tado schedule",
   "transparent": false,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_inside_c{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_target_c{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs target",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_inside_c{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_target_c{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs target",
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_weather_outside_c",
     "legendFormat": "Outside",
     "refId": "E"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 600000,
      "gradientMode": "opacity"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs target"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs target"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Outside"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Heating demand",
   "description": "How hard tado is asking the boiler to heat each zone",
   "transparent": false,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_heating_pct{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_heating_pct{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 600000,
      "gradientMode": "opacity"
     },
     "min": 0,
     "max": 100
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Humidity",
   "description": "",
   "transparent": false,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_humidity_pct{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_humidity_pct{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 600000,
      "gradientMode": "opacity"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 4,
   "type": "barchart",
   "title": "Gas per day vs heating demand",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 18
   },
   "interval": "1d",
   "description": "Gas kWh from Octopus (lags 1-2 days); heating = average tado demand across both zones that day; outside = average temperature",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(sum_over_time(octopus_gas_kwh[1d] offset -1d))",
     "legendFormat": "Gas kWh",
     "refId": "A",
     "interval": "1d"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "avg(avg_over_time(tado_heating_pct[1d] offset -1d))",
     "legendFormat": "Avg heating demand %",
     "refId": "B",
     "interval": "1d"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "avg_over_time(tado_weather_outside_c[1d] offset -1d)",
     "legendFormat": "Avg outside \u00b0C",
     "refId": "C",
     "interval": "1d"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "Time",
      "mode": "outer"
     }
    }
   ],
   "options": {
    "orientation": "vertical",
    "xField": "Time",
    "xTickLabelRotation": -45,
    "xTickLabelSpacing": 60,
    "showValue": "never",
    "stacking": "none",
    "groupWidth": 0.8,
    "barWidth": 0.95,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 1,
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Gas kWh"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Avg heating demand %"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Avg outside \u00b0C"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Time"
      },
      "properties": [
       {
        "id": "unit",
        "value": "time:D MMM"
       }
      ]
     }
    ]
   }
  }
 ]
}
