{
 "uid": "heating",
 "title": "Heating",
 "tags": [
  "tado",
  "octopus"
 ],
 "timezone": "browser",
 "editable": true,
 "refresh": "2m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Room and outside temperature",
   "description": "Dashed = target set by the tado schedule",
   "transparent": false,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_inside_c{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_target_c{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs target",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_inside_c{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_target_c{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs target",
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_weather_outside_c",
     "legendFormat": "Outside",
     "refId": "E"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 600000,
      "gradientMode": "opacity"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs target"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs target"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          6
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Outside"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Heating demand",
   "description": "How hard tado is asking the boiler to heat each zone",
   "transparent": false,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_heating_pct{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_heating_pct{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 600000,
      "gradientMode": "opacity"
     },
     "min": 0,
     "max": 100
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Humidity",
   "description": "Room humidity from tado. The dashed line is tado-monitor's damp warning (70% for 3 hours): condensation and mould become likely.",
   "transparent": false,
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_humidity_pct{zone=\"Downstairs\"}",
     "legendFormat": "Downstairs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "tado_humidity_pct{zone=\"Upstairs\"}",
     "legendFormat": "Upstairs",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 600000,
      "gradientMode": "opacity",
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 70
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "purple"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 4,
   "type": "barchart",
   "title": "Gas per day vs heating demand",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 18
   },
   "interval": "1d",
   "description": "Gas kWh from Octopus (lags 1-2 days); heating = average tado demand across both zones that day; outside = average temperature",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "sum(sum_over_time(octopus_gas_kwh[1d] offset -1d))",
     "legendFormat": "Gas kWh",
     "refId": "A",
     "interval": "1d"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "avg(avg_over_time(tado_heating_pct[1d] offset -1d))",
     "legendFormat": "Avg heating demand %",
     "refId": "B",
     "interval": "1d"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "avg_over_time(tado_weather_outside_c[1d] offset -1d)",
     "legendFormat": "Avg outside °C",
     "refId": "C",
     "interval": "1d"
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "Time",
      "mode": "outer"
     }
    }
   ],
   "options": {
    "orientation": "vertical",
    "xField": "Time",
    "xTickLabelRotation": -45,
    "xTickLabelSpacing": 60,
    "showValue": "never",
    "stacking": "none",
    "groupWidth": 0.8,
    "barWidth": 0.95,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 1,
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Gas kWh"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Avg heating demand %"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Avg outside °C"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Time"
      },
      "properties": [
       {
        "id": "unit",
        "value": "time:D MMM"
       }
      ]
     }
    ]
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Gas used vs expected for the weather",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 28
   },
   "interval": "1d",
   "timeFrom": "42d",
   "description": "Daily gas (bars) against what the house normally uses at that day's outside temperature (line), from usage-watch. Each day's expectation is fitted only to the days before it, so a lasting change to the heating shows as a gap. Mark a change (e.g. a boiler setting) with Ctrl+click to add an annotation.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max_over_time(usage_gas_kwh[1d])",
     "legendFormat": "Used",
     "refId": "A",
     "interval": "1d"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max_over_time(usage_gas_expected_kwh[1d])",
     "legendFormat": "Expected",
     "refId": "B",
     "interval": "1d"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max_over_time(usage_gas_outside_c[1d])",
     "legendFormat": "Outside °C",
     "refId": "C",
     "interval": "1d"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 1,
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "always",
      "pointSize": 5,
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Used"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       },
       {
        "id": "custom.drawStyle",
        "value": "bars"
       },
       {
        "id": "custom.fillOpacity",
        "value": 80
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       },
       {
        "id": "custom.showPoints",
        "value": "never"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Expected"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Outside °C"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       },
       {
        "id": "unit",
        "value": "celsius"
       },
       {
        "id": "min",
        "value": null
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     }
    ]
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Gas difference from expected",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 16,
    "x": 0,
    "y": 37
   },
   "interval": "1d",
   "timeFrom": "42d",
   "description": "kWh above (red) or below (green) the expected gas for each day.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max_over_time(usage_gas_kwh[1d]) - max_over_time(usage_gas_expected_kwh[1d])",
     "legendFormat": "Difference",
     "refId": "A",
     "interval": "1d"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": false
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       }
      ]
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 1,
      "showPoints": "never",
      "thresholdsStyle": {
       "mode": "off"
      },
      "gradientMode": "scheme"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Past week vs expected",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 37
   },
   "description": "Gas over the last 9 days (Octopus data lags 1-2 days, so about a week of days) against the weather-adjusted expectation.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "100 * (sum_over_time(usage_gas_kwh[9d]) / sum_over_time(usage_gas_expected_kwh[9d]) - 1)",
     "legendFormat": "vs expected",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Warm-up time after the heating comes on",
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 45
   },
   "timeFrom": "35d",
   "description": "Hours each zone took to reach its new target after the target was raised by at least 1 °C (big points), and how long the last degree of that took (small points) - the part usage-watch compares with the usual. A rising last-degree trend in cold weather can mean the boiler's flow temperature is too low.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max by (zone) (max_over_time(heating_warmup_min[2h])) / 60",
     "legendFormat": "{{zone}}",
     "refId": "A",
     "interval": "30m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max by (zone) (max_over_time(heating_warmup_last_min[2h])) / 60",
     "legendFormat": "{{zone}} last °C",
     "refId": "C",
     "interval": "30m"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "max(max_over_time(heating_warmup_outside_c[2h]))",
     "legendFormat": "Outside °C at start",
     "refId": "B",
     "interval": "30m"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "h",
     "decimals": 1,
     "min": 0,
     "custom": {
      "drawStyle": "points",
      "pointSize": 8,
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "always",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Outside °C at start"
      },
      "properties": [
       {
        "id": "unit",
        "value": "celsius"
       },
       {
        "id": "min",
        "value": null
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       },
       {
        "id": "custom.pointSize",
        "value": 5
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Downstairs last °C"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "light-blue"
        }
       },
       {
        "id": "custom.pointSize",
        "value": 5
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstairs last °C"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "light-orange"
        }
       },
       {
        "id": "custom.pointSize",
        "value": 5
       }
      ]
     }
    ]
   }
  }
 ],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
