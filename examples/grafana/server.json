   "title": "CPU temperature",
   "description": "Now",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "expr": "last_over_time(host_cpu_temp_c{host=~\"$host\"}[15m])",
     "legendFormat": "CPU temperature",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
