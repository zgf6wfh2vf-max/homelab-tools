   {
    "name": "host",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "vm"
    },
    "query": {
     "query": "label_values(host_cpu_temp_c, host)",
     "refId": "host"
    },
    "definition": "label_values(host_cpu_temp_c, host)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
