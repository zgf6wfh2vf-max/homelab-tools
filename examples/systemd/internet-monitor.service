# internet-monitor.service - Broadband outage and latency watch (runs continuously)
# Install: see docs/internet-monitor.md. Settings live in /etc/homelab-tools/internet-monitor.env.
[Unit]
Description=Broadband outage and latency watch
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/homelab-tools/bin/internet-monitor watch
EnvironmentFile=/etc/homelab-tools/internet-monitor.env
Restart=always
RestartSec=30
User=homelab
Group=homelab
StateDirectory=internet-monitor
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
