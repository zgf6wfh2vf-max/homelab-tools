# internet-speedtest.service - One broadband speed test (started by internet-speedtest.timer)
[Unit]
Description=Broadband speed test
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/internet-monitor speedtest
EnvironmentFile=/etc/homelab-tools/internet-monitor.env
User=homelab
Group=homelab
StateDirectory=internet-monitor
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
