# octopus-sessions.service - Octopus Power Down / Power Up session alerts
# Install: see docs/octopus-sessions.md. Settings live in /etc/homelab-tools/octopus-sessions.env.
[Unit]
Description=Octopus flexibility session alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/octopus-sessions
EnvironmentFile=/etc/homelab-tools/octopus-sessions.env
User=homelab
Group=homelab
StateDirectory=octopus-sessions
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
