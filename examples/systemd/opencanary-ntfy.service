# opencanary-ntfy.service - Relay OpenCanary honeypot events to ntfy
# Install: see docs/installation.md. Settings live in /etc/homelab-tools/opencanary-ntfy.env.
[Unit]
Description=Relay OpenCanary honeypot events to ntfy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/homelab-tools/bin/opencanary-ntfy
EnvironmentFile=/etc/homelab-tools/opencanary-ntfy.env
Restart=always
RestartSec=60
User=homelab
Group=homelab
StateDirectory=opencanary-ntfy
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
