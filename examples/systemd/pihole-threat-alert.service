# pihole-threat-alert.service - Alert on DNS lookups of threat-list domains (Pi-hole)
# Install: see docs/installation.md. Settings live in /etc/homelab-tools/pihole-threat-alert.env.
[Unit]
Description=Alert on DNS lookups of threat-list domains (Pi-hole)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/pihole-threat-alert
EnvironmentFile=/etc/homelab-tools/pihole-threat-alert.env
User=homelab
Group=homelab
StateDirectory=pihole-threat-alert
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
