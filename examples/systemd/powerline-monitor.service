# powerline-monitor.service - Powerline adapter link speed and availability
# Install: see docs/powerline-monitor.md. Settings live in /etc/homelab-tools/powerline-monitor.env.
[Unit]
Description=Powerline adapter link speed and availability
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/powerline-monitor
EnvironmentFile=/etc/homelab-tools/powerline-monitor.env
User=homelab
Group=homelab
StateDirectory=powerline-monitor
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
