# solar-forecast.service - Solar generation forecast from Forecast.Solar
# Install: see docs/installation.md. Settings live in /etc/homelab-tools/solar-forecast.env.
[Unit]
Description=Solar generation forecast from Forecast.Solar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/solar-forecast
EnvironmentFile=/etc/homelab-tools/solar-forecast.env
User=homelab
Group=homelab
StateDirectory=solar-forecast
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
