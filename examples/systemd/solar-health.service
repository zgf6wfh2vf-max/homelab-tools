# solar-health.service - Daily check of the solar strings, generation against forecast and battery health
# Install: see docs/solar-health.md. Settings live in /etc/homelab-tools/solar-health.env.
[Unit]
Description=Solar and battery health check

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/solar-health
EnvironmentFile=/etc/homelab-tools/solar-health.env
User=homelab
Group=homelab
StateDirectory=solar-health
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
