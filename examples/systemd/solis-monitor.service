# solis-monitor.service - Solis hybrid inverter monitor (local Modbus, read-only)
# Install: see docs/installation.md. Settings live in /etc/homelab-tools/solis-monitor.env.
[Unit]
Description=Solis hybrid inverter monitor (local Modbus, read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/homelab-tools/bin/solis-monitor
EnvironmentFile=/etc/homelab-tools/solis-monitor.env
Restart=always
RestartSec=60
User=homelab
Group=homelab
StateDirectory=solis-monitor
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
