# tado-monitor.service - tado heating monitor (read-only)
# Install: see docs/installation.md. Settings live in /etc/homelab-tools/tado-monitor.env.
[Unit]
Description=tado heating monitor (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/homelab-tools/bin/tado-monitor
EnvironmentFile=/etc/homelab-tools/tado-monitor.env
Restart=always
RestartSec=60
User=homelab
Group=homelab
StateDirectory=tado-monitor
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
