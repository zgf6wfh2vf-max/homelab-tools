# usage-watch.service - Unusual gas and electricity use alerts
# Install: see docs/usage-watch.md. Settings live in /etc/homelab-tools/usage-watch.env.
[Unit]
Description=Unusual gas and electricity use alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/usage-watch
EnvironmentFile=/etc/homelab-tools/usage-watch.env
User=homelab
Group=homelab
StateDirectory=usage-watch
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
