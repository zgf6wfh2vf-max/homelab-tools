# weekly-report.service - Weekly energy summary to ntfy
# Install: see docs/installation.md. Settings live in /etc/homelab-tools/weekly-report.env.
[Unit]
Description=Weekly energy summary to ntfy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/homelab-tools/bin/weekly-report
EnvironmentFile=/etc/homelab-tools/weekly-report.env
User=homelab
Group=homelab
StateDirectory=weekly-report
ReadWritePaths=/var/lib/homelab-status
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
